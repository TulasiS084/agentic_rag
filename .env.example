# ==========================================
# Agentic RAG Configuration & API Keys
# ==========================================

# --- IBM WatsonX Configuration ---
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# --- OpenAI / Compatible Provider (Groq, Ollama, OpenRouter, etc.) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Local Hugging Face / Transformers Model ---
# Options cached locally: google/flan-t5-base, TinyLlama/TinyLlama-1.1B-Chat-v1.0
LOCAL_LLM_MODEL=google/flan-t5-base

# --- Embedding & Reranker Models ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG Default Hyperparameters ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DENSE_TOP_K=10
SPARSE_TOP_K=10
TOP_N_RERANK=5
LLM_TOP_K=4
RRF_K=60
